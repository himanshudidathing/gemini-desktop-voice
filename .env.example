# Reasoning/vision providers: GOOGLE, GROQ, or BOTH.
# BOTH prefers Groq, then falls back to Google on quota exhaustion/unavailability.
# Voice ALWAYS uses Google, including in GROQ mode.
MODEL=BOTH

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ASSISTANT_NAME=Gemini
GEMINI_VOICE=Aoede
GOOGLE_STT_MODEL=gemini-3.5-transcribe-live
GOOGLE_TTS_MODEL=gemini-3.8-flash-lite-tts

# Groq console: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Compatibility default for older SDK/preset clients.
# The sidebar uses Gemma 26B for simple Google requests and 31B for complex work.
GEMINI_MODEL=gemma-4-31b-it
# Legacy conversational Live client only; the sidebar uses GOOGLE_STT_MODEL.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Google reasoning models each have a local 30 RPM / 16k TPM guard.
# Groq has its own 30 RPM / 16k TPM guard shared by its reasoning/vision requests.
# Local token estimates; no countTokens or validation requests.
# Actual provider quotas and speech pricing depend on your account.
# Nonempty environment values override saved settings at startup.
# Never commit .env or real API keys.
