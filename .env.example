# Google AI Studio key: https://aistudio.google.com/apikey
# Copy this file to .env. Never commit your real key.
GEMINI_API_KEY=

# Name for locally recognized voice tasks (2–32 characters).
GEMINI_ASSISTANT_NAME=Gemini

# Compatibility settings for older presets/SDK consumers.
# The new sidebar automatically routes to gemma-4-26b-a4b-it or gemma-4-31b-it.
GEMINI_MODEL=gemma-4-31b-it

# Legacy Live settings are retained by the settings loader.
# The local-first sidebar does NOT stream microphone audio to Google Live.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Aoede

# Each model has its own local 30 RPM / 16,000 TPM guard.
# No countTokens or connection-check requests. Local estimates reconcile with usage.
# First request is immediate; back-to-back requests are spaced ~1 second.
# Windows offline speech recognition + installed OS voice handle live voice.
# Explicit audio-file uploads use gemini-3.8-flash, with a separate model budget.
# Non-empty environment values override saved settings at each startup.
