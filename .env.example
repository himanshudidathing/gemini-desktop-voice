# Google AI Studio API key: https://aistudio.google.com/apikey
# Copy this file to .env and enter your own key. Never commit .env.
GEMINI_API_KEY=

# Task model: hosted Gemma 4 or Gemini vision. Use IDs available to your project.
GEMINI_MODEL=gemma-4-31b-it
GEMINI_LIVE_MODEL=gemini-3.8-live

# Name to say before a voice command (2–32 characters).
GEMINI_ASSISTANT_NAME=Gemini

# Supported voices: Aoede, Kore, Puck, Charon, Fenrir.
GEMINI_VOICE=Aoede

# Non-empty environment values override saved settings at startup.
# Leave a variable blank to use the saved app setting or its default.
# No Google Cloud service-account file or other provider key is required.

# REST budget is fixed at 30 requests / 16,000 tokens per rolling minute.
# Includes countTokens preflight calls; Gemini Live has separate streaming quotas.
# Audio uploads use gemini-3.8-flash independently of the task model.
